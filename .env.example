# Public site URL (used for share links, RSS and sitemap).
NEXT_PUBLIC_SITE_URL="https://nebulark.net"
NEXT_PUBLIC_BASE_URL="https://nebulark.net"

# Blog posts live in Supabase (run supabase/blog-schema.sql). No third-party blog keys needed.


# ----- Careers feature -----
# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the client. Bypasses RLS for privileged actions.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com → API Keys)
RESEND_API_KEY=
# Verified sender. Use onboarding@resend.dev until your domain is verified.
CAREERS_FROM_EMAIL=onboarding@resend.dev
# Where "new application" alerts are sent (shared team inbox).
CAREERS_NOTIFY_EMAIL=careers@example.com