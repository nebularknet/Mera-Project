# Obtain Blog ID from from https://www.wisp.blog/app/setup
NEXT_PUBLIC_BLOG_ID=cluqyx1rl0000l5ds3f0vkfer
NEXT_PUBLIC_BASE_URL="https://example.com"
NEXT_PUBLIC_BLOG_ORGANIZATION="My Organization"
NEXT_PUBLIC_BLOG_TITLE="My Blog Title"
NEXT_PUBLIC_BLOG_DESCRIPTION="My Blog Description"

# ----- Careers feature -----
# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the client. Bypasses RLS for privileged actions.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com → API Keys)
RESEND_API_KEY=
# Verified sender. Use onboarding@resend.dev until your domain is verified.
CAREERS_FROM_EMAIL=onboarding@resend.dev
# Where "new application" alerts are sent (shared team inbox).
CAREERS_NOTIFY_EMAIL=careers@example.com